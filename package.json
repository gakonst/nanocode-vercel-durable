{
  "name": "nanocode-vercel-durable",
  "private": true,
  "description": "nanocode agents made durable on a Vercel Workflow World with durable-harness",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('fs').copyFileSync('node_modules/nanocode-ts/dist/nanocode_wasm.wasm','public/nanocode_wasm.wasm')\" && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "cli": "node --disable-warning=ExperimentalWarning scripts/cli.ts",
    "drill": "node --disable-warning=ExperimentalWarning scripts/drill.ts"
  },
  "dependencies": {
    "@pierre/highlights": "0.2.0",
    "@vercel/oidc": "3.2.0",
    "durable-harness": "0.0.1-beta.6",
    "nanocode-ts": "github:gakonst/nanocode-ts#1fa48fbc72d52e473ac44d8244ddbedafe741be7",
    "next": "16.4.2",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zyzz": "0.0.40"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "6.0.2"
  }
}
